# Runtime mode. docker-compose.yml hardcodes this to `production` for
# the backend service in production deploys; this line matters only if
# you run the backend outside Docker.
NODE_ENV=production

# Database
DB_ROOT_PASSWORD=
DB_NAME=coinvane
DB_USER=coinvane
DB_PASSWORD=
# Auth & encryption (generate with: openssl rand -hex 64 / openssl rand -hex 32)
JWT_SECRET=
ENCRYPTION_KEY=

# Google Sign-In (the SAME value goes in both vars — backend verifies, frontend renders the button)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ───────────────────────────────────────────────────────────────────
# Microsoft Sign-In (Entra ID + personal MSA) — optional.
# When set, a "Continue with Microsoft" button appears on the sign-in
# page between Google and the one-time link. The allowlist still gates
# who actually gets in — this is just an additional sign-in method.
#
# How to get a client id:
#   1. https://portal.azure.com → App registrations → New registration
#   2. Supported account types: "Accounts in any organizational directory
#      (Any Microsoft Entra ID tenant — Multitenant) and personal
#      Microsoft accounts (e.g. Xbox / Outlook.com)"
#   3. Redirect URI (Single-page application): https://YOUR-DOMAIN/auth
#   4. After registration → Authentication:
#        - Add http://localhost:5173/auth as another SPA redirect URI
#          if you'll do local dev
#        - Front-channel logout URL: https://YOUR-DOMAIN/logout
#          (Coinvane serves a logout landing page at that path)
#   5. Token configuration → +Add optional claim → ID → check "email"
#      → click Add (if it prompts to add Graph email permission, say Yes)
#   6. Overview → copy Application (client) ID into MICROSOFT_CLIENT_ID
#
# No client secret is used (MSAL popup + PKCE). Same value goes in both
# vars: backend verifies the ID token, frontend uses it to build the
# MSAL popup. The frontend also reads the id from /auth/public-config
# at runtime, so VITE_MICROSOFT_CLIENT_ID is optional if you'd rather
# not bake it into the built bundle.
MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
# ───────────────────────────────────────────────────────────────────

# ───────────────────────────────────────────────────────────────────
# Email allowlist — CRITICAL for public deployments.
# Comma-separated list of Google emails that are allowed to sign in.
# Any other Google account is rejected with HTTP 403.
# Leave empty to disable the allowlist (NOT recommended for public hosting).
ALLOWED_EMAILS=
# ───────────────────────────────────────────────────────────────────

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_REDIRECT_URI=
PLAID_WEBHOOK_URL=

# How often the worker polls Plaid for new transactions, in minutes.
# Default is 60 (every hour). Plaid's own guidance is 4-6 hours; more
# frequent is fine as a safety net for missed webhooks but won't make
# pending charges arrive any faster than your bank itself reports them
# (most banks update Plaid in their own 30-60 minute cycle). Webhook-
# driven syncs fire instantly regardless of this interval.
# Suggested values: 30, 60, 120, 240, 360.
SYNC_INTERVAL_MINUTES=60

# First Google sign-in automatically becomes admin; no INITIAL_USER vars needed.

# App URL (used in emails)
APP_URL=
CORS_ORIGIN=

# Signup mode: "invite" (default), "open", or "closed"
SIGNUP_MODE=invite

# ───────────────────────────────────────────────────────────────────
# Sign in with a one-time link (email-based passwordless auth).
#   false (default) — feature is fully disabled; the login page shows
#                      only Google Sign-In.
#   true            — allowlisted emails can request a 15-min one-time
#                      sign-in link via email. Google users can also
#                      use it — both sign-in methods converge on the
#                      same account row (dedup by email).
# Requires EMAIL_CONFIG=enabled + working SMTP below; otherwise the
# request endpoint returns 503.
# The link URL is https://your-app/#signin?t=<48-byte-random-token>
# and the raw token is only ever sent in the email (SHA-256 hashed at
# rest, one-time use, 15-minute expiry).
ONE_TIME_LINK_ENABLED=false

# Strict-IP binding for the one-time sign-in link.
#   true (default) — the IP that requested the link must match the IP
#                    that clicks it. Prevents a stolen-email attacker
#                    on a different network from redeeming.
#                    BREAKS the cross-device flow (request on laptop,
#                    click on phone) because the two IPs differ.
#                    Also breaks IPv6-rotation on iOS/Android and any
#                    CGNAT churn on mobile carriers.
#   false          — record the IP but don't enforce. Recommended if
#                    you use cross-device flow or your users are on
#                    mobile networks.
# Cross-context handoff codes (shown after the browser signs in and
# entered manually in the installed PWA on iOS) are NOT bound to IP
# — they always work on the same or a different device.
ONE_TIME_LINK_STRICT_IP=true

# ───────────────────────────────────────────────────────────────────
# Email subsystem master switch.
#   disabled (default) — no emails sent; in-app notifications still work.
#   enabled            — actually sends mail via the SMTP config below.
# Keep disabled until you've configured + tested SMTP. The UI greys out
# the Email Notifs toggle when this is disabled and shows a warning.
EMAIL_CONFIG=disabled
# ───────────────────────────────────────────────────────────────────

# SMTP (only used when EMAIL_CONFIG=enabled)
# Leave SMTP_HOST blank to log emails to console even when enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Coinvane <noreply@example.com>

# ───────────────────────────────────────────────────────────────────
# Web Push (OS-level notifications) — optional.
# Generate a key pair ONCE with:
#     npx web-push generate-vapid-keys
# then paste the two values below. VAPID_SUBJECT must be either a
# mailto: URL or an https: URL identifying you (push services reject
# empty). If any of these are blank, push is silently disabled — the
# rest of the app still works, users just see "not configured on the
# server" if they try to enable push in Settings.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Instance-wide operator contact — push services (FCM / Apple / Mozilla)
# use this only if they need to reach whoever runs THIS server about
# abuse or delivery issues. End users never see it. Use a role address
# you monitor OR your public app URL. Personal emails are a bad idea on
# multi-user instances since abuse reports go there directly.
VAPID_SUBJECT=https://your-instance.example.com
#
# ⚠ Firewall / DNS notes for Web Push:
#   • The SERVER needs outbound HTTPS to these hosts to actually deliver
#     pushes (blocked outbound = silent failure in worker logs):
#       fcm.googleapis.com                      (Chrome, Edge, Android)
#       updates.push.services.mozilla.com       (Firefox)
#       web.push.apple.com                      (Safari / iOS PWAs)
#       *.notify.windows.com                    (Edge on Windows only)
#   • The USER'S OWN NETWORK must also reach those hosts — pushManager
#     .subscribe() calls them directly from the browser. Pihole /
#     NextDNS / corporate proxies sometimes block fcm.googleapis.com
#     as "Google telemetry"; the browser then errors with
#     "AbortError: Registration failed - push service error".